{
  "name": "food-delivery-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Food Delivery App - Frontend Application",
  "author": "FoodDelivery Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/food-delivery-frontend.git"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx --fix",
    "lint:check": "eslint src --ext .js,.jsx",
    "format": "prettier --write 'src/**/*.{js,jsx,css,json}'",
    "format:check": "prettier --check 'src/**/*.{js,jsx,css,json}'",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "preview": "serve -s build",
    "clean": "rm -rf build",
    "dev": "npm start"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.18",
    "@react-google-maps/api": "^2.19.2",
    "@stripe/react-stripe-js": "^2.5.0",
    "@stripe/stripe-js": "^2.2.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.1",
    "framer-motion": "^10.18.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^4.12.0",
    "react-leaflet": "^4.2.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.20.1",
    "react-scripts": "5.0.1",
    "react-slick": "^0.29.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.8.3",
    "sockjs-client": "^1.6.1",
    "stompjs": "^2.3.3",
    "swiper": "^11.0.5",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.1.0",
    "source-map-explorer": "^2.5.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "jest": {
    "moduleNameMapper": {
      "^@components/(.*)$": "<rootDir>/src/components/$1",
      "^@pages/(.*)$": "<rootDir>/src/pages/$1",
      "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@contexts/(.*)$": "<rootDir>/src/contexts/$1",
      "^@styles/(.*)$": "<rootDir>/src/styles/$1",
      "^@assets/(.*)$": "<rootDir>/src/assets/$1"
    }
  }
}
